FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /opt/optopsy-delta
COPY pyproject.toml README.md constraints-cpu-compat.txt ./
COPY src ./src
COPY config.toml ./config.toml
RUN python -m pip install --no-cache-dir -c constraints-cpu-compat.txt ".[research]"
USER 65532:65532
CMD ["python", "-m", "optopsy_delta.paper_worker", "--interval", "60"]
